# Copy to .env and fill in. NEVER commit .env. Keys are read from the environment only.
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                      # optional; leave blank to use the provider default in core/llm_client.py
LLM_TEMPERATURE=0
OUTPUT_DIR=outputs
